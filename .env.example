# 站点域名。生产环境建议配置真实域名，Caddy 会自动申请 HTTPS 证书。
SITE_DOMAIN=learn.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=learn_liangliang
POSTGRES_USER=learn
POSTGRES_PASSWORD=请替换为强密码

# Go API
DATABASE_URL=postgres://learn:请替换为强密码@db:5432/learn_liangliang?sslmode=disable
APP_ADDR=:8080
APP_COOKIE_NAME=learn_session
APP_COOKIE_SECURE=true
APP_SESSION_TTL_HOURS=720

# 管理员预置账号；首次启动或后续启动都会按该配置创建/更新该账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为至少12位管理员强密码
ADMIN_DISPLAY_NAME=管理员
